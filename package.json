{
  "name": "nextjs-postgresql-template",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "assets": "node scripts/setup-assets.mjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:integration",
    "db:dev": "node scripts/dev-db.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:status": "node scripts/migrate.mjs --status",
    "migrate": "node scripts/migrate.mjs",
    "admin:grant": "node scripts/grant-admin.mjs",
    "fixtures": "node scripts/make-test-fixtures.mjs",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "pretest:integration": "npm run build"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "docx": "^9.14.0",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.61.0",
    "mammoth": "^1.13.0",
    "next": "16.2.6",
    "nodemailer": "^7.0.13",
    "pdfjs-dist": "^6.4.299",
    "pg": "8.20.0",
    "pptxgenjs": "^4.0.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tesseract.js": "^7.0.0",
    "utif": "^3.1.0",
    "vitest": "^5.0.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@electric-sql/pglite-socket": "^0.2.17",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  }
