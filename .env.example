# ---------------------------------------------------------------------------
# PDF Pro — environment variables
#
# Copy to `.env` and fill in what you need. Only the first two blocks are
# required to run locally; every integration below stays disabled (and the UI
# explains why) until its variables exist. Secrets are read on the server only:
# none of the keys marked "server" are exposed to the browser bundle.
# ---------------------------------------------------------------------------

# --- Core (required) -------------------------------------------------------
# PostgreSQL connection string used by Drizzle, the API routes and the workers.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres
# Public origin of the deployment. Used for email links, OAuth redirects and
# the checkout return URL. Omit to derive it from the incoming request.
APP_URL=http://localhost:3000
# Signs session cookies, download links and email tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-a-64-character-random-string
# Connection pool size per server instance (default 10).
# PG_POOL_MAX=10

# --- Authentication -------------------------------------------------------
# Session lifetime in days (default 30). Sessions are opaque tokens stored
# as SHA-256 hashes, so they survive restarts and work on every device.
AUTH_SESSION_DAYS=30
# Email verification link lifetime (hours, default 48).
AUTH_VERIFY_TOKEN_HOURS=48
# Password reset link lifetime (minutes, default 60).
AUTH_RESET_TOKEN_MINUTES=60
# ONLY for local development: return verification/reset links in API
# responses when EMAIL_TRANSPORT=console. Never enable in production.
AUTH_EXPOSE_DEV_LINKS=false
# Google sign-in (optional). Redirect URI:
#   <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Transactional email --------------------------------------------------
# console | smtp | resend   (console prints to stdout and the email outbox)
EMAIL_TRANSPORT=console
EMAIL_FROM="PDF Pro <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Alternative: a single URL such as smtp://user:pass@host:587
SMTP_URL=
# resend.com API key (used when EMAIL_TRANSPORT=resend)
RESEND_API_KEY=

# --- Cloud storage --------------------------------------------------------
# This deployment targets Neon (Postgres) + Cloudflare R2 (files).
# local | s3   ("s3" works with Cloudflare R2, Neon Object Storage, AWS S3,
# MinIO and any other S3-compatible endpoint; buckets stay private either way)
STORAGE_DRIVER=s3
# Used by the local driver only (must not be inside public/).
STORAGE_DIR=.data/storage
# S3-compatible bucket. Create it in the Cloudflare dashboard (R2 → Create
# bucket) and keep it private: every read goes through a signed server URL.
S3_BUCKET=pdfpro-files
# Explicit S3 credentials (S3_* wins over the AWS_* aliases).
# Cloudflare R2 → Manage R2 API Tokens → Create token (Object Read & Write).
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Cloudflare R2 endpoint: https://<account-id>.r2.cloudflarestorage.com
# (Neon Object Storage would be https://us-east-2.aws.neon.tech/storage)
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# Cloudflare R2 needs `auto`; Neon/AWS need the real region.
# S3_REGION=auto
# Path-style addressing: true for Neon/MinIO, FALSE for Cloudflare R2
# (R2 uses virtual-hosted style; the default here is true).
# S3_FORCE_PATH_STYLE=false
# Fallbacks read automatically when the S3_* names are absent:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL_S3=
# AWS_REGION=
# Secret used to sign short-lived download URLs.
STORAGE_SIGNING_SECRET=replace-with-another-random-string
# Signed download URL lifetime in seconds (default 300).
STORAGE_SIGNED_URL_TTL=300
# Hard per-file cap in bytes (default 52428800 = 50 MiB). Admins can lower it
# from Admin → Settings; 500 MiB is the ceiling.
STORAGE_MAX_UPLOAD_BYTES=52428800

# --- Plan quotas ----------------------------------------------------------
# Sizes chosen to fit the free tiers (Cloudflare R2: 10 GB of object storage,
# Neon: 1 GB of Postgres per project). Raise them once you have paid capacity.
#   Free    200 MiB  (209715200)  ~50 Free accounts fill the R2 free tier
#   Premium   2 GiB  (2147483648) ~5 Premium accounts fill it
# Per-plan storage is also editable at runtime in Admin → Pricing
# (subscription_plans.storage_bytes), which takes precedence over these.
FREE_PLAN_STORAGE_BYTES=209715200
PREMIUM_PLAN_STORAGE_BYTES=2147483648

# --- Payments (Safepay) ---------------------------------------------------
# sandbox | production   (anything else falls back to sandbox)
SAFEPAY_ENV=sandbox
# Merchant API key from the Safepay dashboard (server only).
SAFEPAY_API_KEY=
# Merchant secret key from the Safepay dashboard (server only).
SAFEPAY_SECRET_KEY=
# Webhook signing secret (Dashboard → Developers → Webhooks). HMAC-SHA512.
SAFEPAY_WEBHOOK_SECRET=
# Legacy hosted-checkout secret used for the redirect signature (HMAC-SHA256).
SAFEPAY_V1_SECRET=
# Optional host overrides (leave empty to use the documented defaults).
SAFEPAY_API_BASE=
SAFEPAY_CHECKOUT_BASE=
# Refuse to start a checkout (support/maintenance switch). Admin → Settings
# can pause checkout at runtime without a redeploy.
BILLING_DISABLED=false
# Days of Premium access after a failed renewal while retries run (default 3).
BILLING_GRACE_DAYS=3

# --- Cloudflare (Turnstile + site verification) ---------------------------
# Human verification on the sign-in, registration, forgot-password and
# reset-password forms. Both keys are required; with either missing the widget
# is not rendered and the server check is skipped (local development, CI).
# Dashboard → Turnstile → Add site → the site key is public, the secret is not.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional: token Cloudflare asks you to publish as a meta tag for domain /
# site verification. Rendered as <meta name="cf-verification" content="…">.
CLOUDFLARE_VERIFICATION_TOKEN=
# Optional: Cloudflare for SaaS custom-hostname challenge token, served at
# /.well-known/cf-custom-hostname-challenge/<token> (404 when unset).
CLOUDFLARE_CUSTOM_HOSTNAME_TOKEN=

# --- Advertising (Google AdSense) -----------------------------------------
# Ads only render when a real publisher id AND a slot id for that placement
# exist, the visitor is on the Free plan, and (if requireConsent) consent was
# given. Leave empty to keep advertising fully disabled.
ADSENSE_ENABLED=false
ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
ADSENSE_SLOT_DASHBOARD=
ADSENSE_SLOT_CLOUD=
ADSENSE_SLOT_PRICING=
ADSENSE_SLOT_TOOLS=

# --- Operations -----------------------------------------------------------
# Comma-separated emails that receive the administrator role on first verified
# sign-in. Everyone else needs `npm run admin:grant -- you@example.com`.
ADMIN_EMAILS=
# Bearer secret for POST /api/cron/maintenance (subscription lifecycle,
# storage cleanup, rate-limit pruning). Call it every 15 minutes.
CRON_SECRET=

# --- Optional -------------------------------------------------------------
# Browser extension id used by the Extension page connection test.
# NEXT_PUBLIC_PDFPRO_EXTENSION_ID=
